# Point both at wherever the Django backend runs.
# http://localhost:8000 for a local backend, or a shared dev URL.
VITE_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Google Ads conversion label for the enquiry conversion action.
# Google Ads -> Goals -> Conversions -> the action -> Tag setup (e.g. AbC-D_efG-h12).
# Inlined at build time by Vite, so it must also be set in the Vercel project.
VITE_GADS_CONVERSION_LABEL=
