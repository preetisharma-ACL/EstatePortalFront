# EstatePortal frontend environment
# Client (browser) base URL — read via import.meta.env in src/lib/api.ts
VITE_API_BASE_URL=https://api.realestate.aajneeti.social
# Server (SSR / route preload) base URL — read via process.env in src/lib/api.ts
API_BASE_URL=https://api.realestate.aajneeti.social

# Google Ads conversion label — see .env.example. Paste the label from
# Google Ads -> Goals -> Conversions -> the action -> Tag setup.
VITE_GADS_CONVERSION_LABEL=
